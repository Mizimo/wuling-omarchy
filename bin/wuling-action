#!/bin/bash
# omarchy:summary=Run a named native Terminal action
# omarchy:args=<wifi|bluetooth|tailscale|dnd|night|power|volume|brightness|mute|play-pause|previous|next|agent|lock|sleep|power-menu|panel> [value]
# omarchy:examples=wuling action volume 40 | wuling action panel audio
set -euo pipefail
exec "$(dirname "$(readlink -f "$0")")/wuling" action "$@"
