#!/usr/bin/env python3
"""Display-free checks; VM captures and hardware acceptance remain separate."""
from pathlib import Path
import json
import hashlib
import re
import subprocess
import sys
sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "bin/lib"))
from wuling import theme, settings
from wuling.cli import commands


def run(argv):
    subprocess.run(argv, cwd=ROOT, check=True)


source = settings.tokens()
assert source["schema_version"] == 1
assert set(source["themes"]) == {"wuling", "wuling-paper", "wuling-hud", "wuling-hud-paper"}
for palette in source["palettes"].values():
    for colour in palette.values():
        theme.rgb(colour)
for name in source["themes"]:
    theme.generated_text(name, {})
assert len(commands()["commands"]) >= 7
font_manifest = json.loads((ROOT / "fonts/manifest.json").read_text())
for entry in font_manifest["fonts"]:
    assert hashlib.sha256((ROOT / "fonts" / entry["file"]).read_bytes()).hexdigest() == entry["sha256"], entry["file"]
for name in ("Geist-OFL.txt", "BarlowCondensed-OFL.txt", "MaterialSymbolsSharp-APACHE.txt"):
    assert (ROOT / "fonts" / name).is_file(), name
for directory in ("bin", "tools", "tests"):
    for path in (ROOT / directory).rglob("*"):
        if not path.is_file() or "__pycache__" in path.parts:
            continue
        data = path.read_bytes()
        if path.suffix == ".py" or data.startswith(b"#!/usr/bin/env python3"):
            compile(data, str(path), "exec")
        elif data.startswith((b"#!/bin/bash", b"#!/bin/sh")):
            run(["bash", "-n", str(path)])
compile((ROOT / "install").read_bytes(), "install", "exec")
run([sys.executable, "-B", "-m", "unittest", "discover", "-s", "tests", "-v"])
run([str(ROOT / "tools/generate"), "--check"])

# Scan staged additions, not deleted lines. Binary assets require visual review;
# ordinary product/generated JSON and the image hash manifest are intentional.
paths = subprocess.check_output(["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z"], cwd=ROOT).decode().split("\0")
patterns = ["/" + r"home/(?!example(?:/|$))[^/\s]+/", "/" + r"Users/[^/\s]+/", r"\b(?:\d{1,3}\.){3}\d{1,3}\b",
            r"-----BEGIN (?:OPENSSH |RSA |EC )?PRIVATE KEY-----", r"\btskey-[A-Za-z0-9-]+", r"\b[a-zA-Z0-9-]+\.ts\.net\b"]
failures = []
for name in filter(None, paths):
    if any(part in {"canon", "music", "evidence"} for part in Path(name).parts) or name.endswith((".qcow2", ".iso", ".log", ".mp4", ".webm")):
        failures.append(name + ": forbidden artifact")
    raw = subprocess.check_output(["git", "show", ":" + name], cwd=ROOT)
    if b"\0" in raw:
        continue
    content = raw.decode("utf-8", errors="replace")
    for pattern in patterns:
        if re.search(pattern, content):
            failures.append(name + ": private-data pattern")
            break
if failures:
    raise SystemExit("\n".join(failures))
run(["git", "diff", "--check"])
run(["git", "diff", "--cached", "--check"])
print("PASS tokens, generation, metadata, syntax, runtime tests and staged privacy scan")
